# RegOps environment template. Copy to .env.dev / .env.test and fill real values there.
# NEVER commit a populated .env — only this template is tracked.
#
# CAUTION: docker-compose.yml sets DATABASE_URL, REDIS_URL and MINIO_ENDPOINT under `environment:`,
# which WINS over `env_file:`. Setting those three here has no effect inside the stack — they are
# fixed by the compose topology. Everything else in this file does take effect per STAGE.
#
# The integration suite writes real documents and versions, so it needs a database a developer is
# not also reading by hand. Select it with REGOPS_DB_NAME rather than DATABASE_URL:
#
#   STAGE=test REGOPS_DB_NAME=regops_test docker compose run --rm regulation \
#       python -m pytest tests/integration -q
#
# `regops_test` is created by infra/postgres/init/02-test-db.sh and migrated the same way:
#   REGOPS_DB_NAME=regops_test docker compose run --rm migrate
#
# What .env.test is genuinely for is everything compose does NOT pin — above all a blank
# LAW_GO_KR_OC and a blank GOVINFO_API_KEY, so a test run cannot reach a government host even by
# accident. Add every new source credential to that file as an explicit blank, not by omission:
# omission works today and stops working the moment something reads the host environment.

STAGE=dev

# --- database -------------------------------------------------------------
# Services connect as the least-privilege role; migrations connect as the owner (ADR-0011).
# (Set inside the stack by compose; this line matters only for host-side tooling.)
DATABASE_URL=postgresql+asyncpg://regops_app:regops-app@db:5432/regops
REGOPS_APP_DB_PASSWORD=regops-app
DB_ECHO=false

# --- auth -----------------------------------------------------------------
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- broker / storage -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=regops
MINIO_SECRET_KEY=<change-me>
MINIO_SECURE=false
MINIO_BUCKET_PREFIX=regops-

# --- LLM seam -------------------------------------------------------------
# KNOWN DEFECT before you set LLM_PROVIDER=claude: the Anthropic client sends `temperature`, which
# extraction and generation both pin to 0.0 (ADR-0017 decision 1), and current Opus- and Sonnet-tier
# models reject it with a 400 — so the claude arm fails on its first generation call. Recorded, not
# fixed (phase1.6 deviation 13); the fix is in ClaudeClient's docstring.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:2b
ANTHROPIC_API_KEY=<your-key-or-leave-blank>
ANTHROPIC_MODEL=claude-sonnet-5
# Generation sends eight retrieved passages and asks for structured JSON back; a small local model
# takes minutes over that, and a timeout kills the answer mid-generation with no row to show for it.
LLM_TIMEOUT_SECONDS=180
# Ollama truncates an over-long prompt silently. A generator that loses the tail of its passage list
# cites a clause it can no longer see — a fabricated citation caused by configuration, not by the
# model. Set this to the window the chosen model actually supports.
OLLAMA_NUM_CTX=32768

# --- source credentials (ADR-0003 decision 13) ----------------------------
# 국가법령정보 OPEN API key, self-designated under 마이페이지 -> API인증키관리 and passed as a
# query-string parameter. It lives here and nowhere else: never in import-source-map.md, never in
# a `sources` row, never in a fetch_observation, never in a test fixture. `sources.url_template`
# carries the literal placeholder `{OC}` and the resolved URL is never persisted or logged.
#
# The account is authorised by egress IP — a request from an unregistered IP returns HTTP 200 with
# an error body, not a 401.
LAW_GO_KR_OC=<your-open-api-oc-or-leave-blank>

# api.data.gov key for govinfo — the FD&C Act (USCODE) and Public Laws (PLAW).
# Free, issued instantly at https://api.data.gov/signup/ and shared across every api.data.gov
# service. DEMO_KEY works without one at 10 requests/hour, which probes but cannot ingest.
GOVINFO_API_KEY=<your-api-data-gov-key-or-leave-blank>

# --- fetch politeness (ADR-0003 decision 9) -------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4
HTTP_MAX_CONCURRENCY_PER_HOST=2
