# RegOps environment template
#
# Copy to .env.dev and fill in. NEVER commit a filled-in .env* file —
# see CLAUDE.md § Security must-follows.
# Real values must not appear in code, tests, fixtures, docs or ADRs.

# --- Source credentials (ADR-0003 decision 13) -------------------------------
# 국가법령정보 OPEN API. The OC value is an authentication key that YOU designate
# at open.law.go.kr, viewable under 마이페이지 > API인증키관리. It travels in the
# query string, so it must never reach a stored URL, a fetch_observation, or a log.
# Choose a high-entropy value — not an email ID or company name.
LAW_GO_KR_OC=

# --- LLM seam ----------------------------------------------------------------
# ollama | claude. Embeddings are always Ollama nomic-embed-text (768-dim, fixed).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=
ANTHROPIC_API_KEY=

# --- Datastores --------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_URL=

# --- Object storage (WORM archive, ADR-0003) ---------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Auth --------------------------------------------------------------------
JWT_SECRET=
