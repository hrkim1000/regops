# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/
*.whl
MANIFEST

# Frontend source lives under src/lib — not a Python build dir; override `lib/` above.
!frontend/src/lib/

# Virtual environments
.venv/
venv/
env/
ENV/
.env.bak

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log
nosetests.xml
test-results/

# mypy / pyright / ruff
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/

# Celery
celerybeat-schedule
celerybeat.pid

# Alembic
# (keep migrations tracked; only ignore temp files)
*.pyc

# =============================================================================
# Node.js / Next.js (frontend/)
# =============================================================================
node_modules/
.next/
.next-e2e/
out/
.nuxt/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo
next-env.d.ts

# Playwright: a signed-in browser state, a trace of a failed run, and a report. The auth state
# holds a real JWT for a real user — it is a credential, and it is regenerated on every run.
frontend/e2e/.auth/
frontend/e2e/.artifacts/
frontend/e2e/.report/
playwright-report/

# =============================================================================
# Environment & secrets
# =============================================================================
.env
.env.dev
.env.test
.env.local
.env.*.local
.env.development
.env.production
.env.staging
*.pem
*.key
*.crt
secrets/

# =============================================================================
# Docker
# =============================================================================
.dockerignore
# ...except the frontend's, which is part of the build definition rather than a local preference.
# `COPY frontend/ ./` would otherwise carry the Playwright suite into the image — including
# `e2e/.auth/*.json`, which holds a signed-in user's JWT. A credential in an image layer is not a
# tidiness problem.
!frontend/.dockerignore

# =============================================================================
# Data & storage (never commit local data volumes)
# =============================================================================
volumes/
minio-data/
postgres-data/
redis-data/

# ML / AI model artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.bin
*.onnx
models/weights/
checkpoints/

# =============================================================================
# IDE / editors
# =============================================================================
# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, IntelliJ, WebStorm)
.idea/
*.iml
*.iws
*.ipr

# =============================================================================
# OS
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# =============================================================================
# Misc
# =============================================================================
*.bak
*.tmp
*.swp
*.swo
*.orig
.sass-cache/

# Corpus source documents — working data, not tracked (also stored in MinIO).
corpus-data/**/*.pdf

# Downloaded regulation originals. The archive of record is the WORM bucket, which is
# content-addressed and immutable; a git copy would be a second, drifting one.
data/

# Evaluation run artifacts and filled assessment worksheets. The artifact is a machine record of
# one run against one model at one moment — the *reviewed* output is the scored markdown and the
# Go/No-Go report, and those are written where they are asked for. Filled worksheets carry an
# assessor's individual judgements and are their working papers, not a repository artifact.
docs/eval/runs/*
docs/eval/worksheets/*
# Keep the directories themselves, so a clone has somewhere for the harness to write and a
# reader finds the note explaining why the contents are absent.
!docs/eval/runs/.gitkeep
!docs/eval/worksheets/.gitkeep
